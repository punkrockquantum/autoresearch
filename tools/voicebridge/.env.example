# voicebridge configuration. Copy to .env, fill in what you use, then:
#   set -a && . ./.env && set +a && voicebridge doctor

# ── routing ───────────────────────────────────────────────────────────────────
VOICEBRIDGE_DEFAULT_TARGET=claude        # claude | chatgpt | perplexity | cursor
VOICEBRIDGE_SPOKEN_WORD_LIMIT=90         # spoken answer budget; "in detail" raises it
VOICEBRIDGE_LONG_WORD_LIMIT=320
VOICEBRIDGE_HISTORY_TURNS=12
VOICEBRIDGE_SESSION_TTL_MINUTES=180
# VOICEBRIDGE_STATE_DIR=~/.local/state/voicebridge
# VOICEBRIDGE_CONFIG=~/.config/voicebridge/config.json

# ── server ────────────────────────────────────────────────────────────────────
VOICEBRIDGE_HOST=0.0.0.0
VOICEBRIDGE_PORT=8808
# Bearer token for /v1/* (iOS Shortcuts, Tasker, curl). Unset = those routes off.
VOICEBRIDGE_INGEST_TOKEN=change-me-long-random

# ── assistants ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# VOICEBRIDGE_CLAUDE_MODEL=claude-opus-5
# VOICEBRIDGE_CLAUDE_MODE=api            # or: cli (runs the Claude Code CLI)
# VOICEBRIDGE_CLAUDE_WORKSPACE=/home/you/autoresearch

OPENAI_API_KEY=
# VOICEBRIDGE_OPENAI_MODEL=gpt-5         # set to a model your key can access
# VOICEBRIDGE_OPENAI_MAX_TOKENS=1024

PERPLEXITY_API_KEY=
# VOICEBRIDGE_PERPLEXITY_MODEL=perplexity/sonar
# VOICEBRIDGE_PERPLEXITY_WEB_SEARCH=true

CURSOR_API_KEY=
# VOICEBRIDGE_CURSOR_MODE=api            # api | cli | queue
# VOICEBRIDGE_CURSOR_REPO=https://github.com/you/autoresearch
# VOICEBRIDGE_CURSOR_REF=master
# VOICEBRIDGE_CURSOR_WORKSPACE=/home/you/autoresearch
# VOICEBRIDGE_CURSOR_QUEUE_FILE=/home/you/autoresearch/PROMPT_QUEUE.md

# ── speech ────────────────────────────────────────────────────────────────────
VOICEBRIDGE_STT_PROVIDER=openai          # openai | groq | local | none
# VOICEBRIDGE_STT_MODEL=whisper-1
# VOICEBRIDGE_STT_LANGUAGE=en
# GROQ_API_KEY=                          # for VOICEBRIDGE_STT_PROVIDER=groq
# VOICEBRIDGE_STT_LOCAL_MODEL=base.en    # for provider=local (faster-whisper)

VOICEBRIDGE_TTS_PROVIDER=openai          # openai | elevenlabs | piper | none
# VOICEBRIDGE_TTS_VOICE=alloy
# VOICEBRIDGE_TTS_FORMAT=opus            # opus keeps voice notes playable
# ELEVENLABS_API_KEY=
# VOICEBRIDGE_PIPER_MODEL=/path/to/en_US-amy-medium.onnx

# ── WhatsApp (route A: fully hands-free) ──────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=pick-any-string
# Required: nothing is accepted from numbers not listed here.
VOICEBRIDGE_ALLOWED_WHATSAPP_SENDERS=+41790000000
# VOICEBRIDGE_WHATSAPP_VOICE_REPLY=false # also send the answer as a voice note

# ── Telegram (route D) ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=another-random-string
VOICEBRIDGE_ALLOWED_TELEGRAM_CHATS=
# VOICEBRIDGE_TELEGRAM_VOICE_REPLY=true
